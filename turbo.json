{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "FUB_API_KEY",
    "NEXT_PUBLIC_FUB_PIXEL_ID",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "ADMIN_PASSWORD",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL",
    "GOOGLE_PRIVATE_KEY",
    "INVENTORY_SHEET_ID",
    "INVENTORY_STATUS_TAB",
    "CONTRACTS_SHEET_ID",
    "CONTRACTS_SHEET_GID",
    "NEXT_PUBLIC_FUB_WIDGET_ID",
    "BASE_URL",
    "RESEND_API_KEY",
    "REPORT_FROM",
    "REPORT_RECIPIENTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
